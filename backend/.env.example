# Copie para backend/.env para rodar a API sem Docker. NUNCA versione o .env real.

# development | test | production (production exige JWT_SECRET forte)
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL local ou Supabase (Project Settings > Database > Connection string).
DATABASE_URL=postgresql+psycopg://traderai:traderai@localhost:5432/traderai

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

ALLOW_REGISTRATION=true
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# --- Dados de mercado ---
# Atualizador dos candles sintéticos dentro do processo da API.
MARKET_WORKER_ENABLED=true
MARKET_WORKER_INTERVAL_SECONDS=20
# Limites de importação de arquivo (bytes) e de geração de histórico por requisição.
IMPORT_MAX_BYTES=52428800
BACKFILL_MAX_CANDLES=600000

# --- Ponte MT5 (somente na máquina Windows do terminal; ver README) ---
# Deixe LOGIN/PASSWORD/SERVER vazios para usar a conta já aberta no terminal.
# Se preencher, use a senha de INVESTIDOR (somente leitura), nunca a senha mestre.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Fuso do servidor da corretora (IANA). Confira com a corretora; muitas usam Europe/Athens.
MT5_SERVER_TIMEZONE=UTC

# Capital fictício das novas contas de simulação.
DEFAULT_SIMULATION_BALANCE=100000
DEFAULT_SIMULATION_CURRENCY=USD

# O único valor aceito é "simulation"; qualquer outro impede a API de iniciar.
TRADING_MODE=simulation

# --- Terminal de mercados binários simulados ---
# Motor em memória (mundo sintético + robô). O histórico se perde ao reiniciar a API.
TERMINAL_ENGINE_ENABLED=true
# Segundos de passado simulados na partida, para a tela não nascer vazia.
TERMINAL_WARMUP_SECONDS=3600
TERMINAL_SEED=7
